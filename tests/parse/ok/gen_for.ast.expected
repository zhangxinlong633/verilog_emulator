design
  module gen_for
    param N
      number 2
    genvar_decl
      ident i
    net_decl
      range
        number 7
        number 0
      unpacked
        range
          number 0
          number 1
      ident y
    net_decl
      range
        number 7
        number 0
      unpacked
        range
          number 0
          number 1
      ident a
    generate
      gen_for g
        init
          blocking
            lhs
              ident i
            rhs
              number 0
        cond
          binary <
            ident i
            ident N
        step
          blocking
            lhs
              ident i
            rhs
              binary +
                ident i
                number 1
        assign
          lhs
            index
              ident y
              ident i
          rhs
            index
              ident a
              ident i
      gen_if wide
        cond
          binary >
            ident N
            number 1
        then
          assign
            lhs
              index
                ident y
                number 0
            rhs
              index
                ident a
                number 0
        else narrow
          assign
            lhs
              index
                ident y
                number 0
            rhs
              index
                ident a
                number 1
